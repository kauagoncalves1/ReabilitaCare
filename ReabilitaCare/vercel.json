{
  "rewrites": [
    { "source": "/", "destination": "/pages/index.html" },
    { "source": "/sobre", "destination": "/pages/sobre.html" },
    { "source": "/agendamentos", "destination": "/pages/agendamentos.html" },
    { "source": "/contato", "destination": "/pages/contato.html" },
    { "source": "/login", "destination": "/pages/login.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}